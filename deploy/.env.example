# Settings for deploy/docker-compose.yml. deploy/setup.sh writes deploy/.env for you.

# Port the app is served on over plain HTTP (http://<this box>:8080).
HTTP_PORT=8080

# HTTPS (optional): a domain whose DNS points at this box, with ports 80 and 443 open.
# Leave empty for HTTP only. With a domain, start with `docker compose --profile https up -d`.
DOMAIN=
# Required with a domain: Let's Encrypt's account email (certificate expiry notices go here).
ACME_EMAIL=

# Prebuilt image (default), or build this checkout: PWA_IMAGE=tvandj-pwa:local and PWA_PULL_POLICY=build.
PWA_IMAGE=ghcr.io/chrisdmacrae/tvandj-pwa:latest
PWA_PULL_POLICY=missing

# Optional, only used when building: IMDb and Rotten Tomatoes ratings (https://www.omdbapi.com/apikey.aspx).
OMDB_API_KEY=
